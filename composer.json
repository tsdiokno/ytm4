{
  "name": "crowd-q/crowd-q",
  "description": "Synchronized YouTube Queue and Jukebox with PHP State Engine and Epoch Calculations",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Crowd-Q Team"
    }
  ],
  "require": {
    "php": "^7.4 || ^8.0 || ^8.1 || ^8.2 || ^8.3",
    "ext-json": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.10",
    "phpunit/phpunit": "^9.6 || ^10.0"
  },
  "autoload": {
    "files": [
      "api/common.php"
    ]
  },
  "scripts": {
    "serve": "php -S 127.0.0.1:8000 scripts/php-router.php",
    "lint": "phpstan analyse api --level=5",
    "test": "phpunit tests"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
